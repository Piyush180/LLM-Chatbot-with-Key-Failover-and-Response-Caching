# ---------- backend ----------
# Comma-separated key pool (at least 2). Ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-gemini-api-key-1,your-gemini-api-key-2
# LiteLLM model name used for every key.
LLM_MODEL=gemini/gemini-2.5-flash
# SQLite file (inside the Docker volume mounted at /data).
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins allowed to call the backend.
ALLOWED_ORIGINS=http://localhost:3000
# true enables the X-Simulate-Failure test header on POST /chat.
ENABLE_FAILURE_SIMULATION=true
# System prompt used when a session has not set its own.
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
# Per-key provider timeout in seconds before failing over.
LLM_TIMEOUT_SECONDS=30

# ---------- frontend (build time) ----------
# Backend base URL baked into the React bundle.
VITE_API_URL=http://localhost:8000
